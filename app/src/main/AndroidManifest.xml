<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Specifies a hardware feature used by the app.
         'android.hardware.telephony' indicates the app uses telephony features.
         'required=false' means the app can work without this feature. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Permissions required by the app -->
    <!-- Allows the app to access the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Allows the app to initiate phone calls. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Allows the app to read data from external storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VMobi"
        tools:targetApi="31">



        <!-- Activity declarations -->
        <!-- Sign up activity, not exported to other apps. -->
        <activity
            android:name=".sign_up"
            android:exported="true">
            <intent-filter>
                <!-- Main action to start the app. -->
                <action android:name="android.intent.action.MAIN" />
                <!-- Category to indicate this activity can be launched from the launcher. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login activity, not exported to other apps. -->
        <activity
            android:name=".login"
            android:exported="false">
        </activity>

        <!-- Identity setup activity, not exported to other apps. -->
        <activity
            android:name=".identity_setup"
            android:exported="false" />

        <!-- Main activity, exported and can be launched by other apps. -->
        <activity
            android:name=".MainActivity"
            android:exported="false">
            <!-- Intent filter to mark this activity as the main entry point. -->
        </activity>
    </application>
</manifest>
